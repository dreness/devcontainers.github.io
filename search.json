---
layout: null
---
[
  {% for page in site.pages %}
    {% unless page.url contains '/static/' or page.url contains '/css/' or page.url contains '/js/' %}
    {
      "title"    : "{{ page.title | escape }}",
      "category" : "{{ page.category | escape }}",
      "url"      : "{{ site.baseurl }}{{ page.url }}",
      "content"  : {{ page.content | strip_html | jsonify }}
    } {% unless forloop.last %},{% endunless %}
    {% endunless %}
  {% endfor %}
  {% for post in site.posts %}
    ,{
      "title"    : "{{ post.title | escape }}",
      "category" : "guide",
      "date"     : "{{ post.date }}",
      "url"      : "{{ site.baseurl }}{{ post.url }}",
      "content"  : {{ post.content | strip_html | jsonify }}
    } {% unless forloop.last %},{% endunless %}
  {% endfor %}
  {% for doc in site.docs %}
    ,{
      "title"    : "{{ doc.title | escape }}",
      "category" : "documentation",
      "url"      : "{{ site.baseurl }}{{ doc.url }}",
      "content"  : {{ doc.content | strip_html | jsonify }}
    } {% unless forloop.last %},{% endunless %}
  {% endfor %}
  {% for implementor in site.implementors %}
    ,{
      "title"    : "{{ implementor.title | escape }}",
      "category" : "specification",
      "url"      : "{{ site.baseurl }}{{ implementor.url }}",
      "content"  : {{ implementor.content | strip_html | jsonify }}
    } {% unless forloop.last %},{% endunless %}
  {% endfor %}
]
